new file mode 100644
index 0000000..70659ad
--- /dev/null
+++ b/BrowserCatalogPolicy.cs
@@ -0,0 +1,10 @@
+namespace Source
+{
+    // ShadowTheAge's blacklist is appropriate for a production calculator, but this
+    // project retains every item reached by recipes, containers, or crafter metadata.
+    // PackConverter's existing touched-item pass still excludes unrelated NEI state.
+    public static class BrowserCatalogPolicy
+    {
+        public const bool RetainRecipeConnectedItems = true;
+    }
+}
diff --git a/ItemBanlist.cs b/ItemBanlist.cs
