@@ -78,7 +78,9 @@ namespace Source
                 using (image)
                 {
                     var positionX = (i & IconAtlas.XMask) * IconAtlas.ImageSize;
-                    var positionY = ((i & IconAtlas.YMask) >> IconAtlas.DimensionBits) * IconAtlas.ImageSize;
+                    // The browser catalog can exceed the original 65,536-sprite page.
+                    // The allocated atlas is already tall enough, so do not wrap later rows.
+                    var positionY = (i >> IconAtlas.DimensionBits) * IconAtlas.ImageSize;
                     
                     atlas.Mutate(x => x.DrawImage(image, new Point(positionX, positionY), 1f));
                 }
