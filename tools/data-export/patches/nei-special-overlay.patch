+/**
+ * Maintained overlay boundary for NEI Custom Diagram and mod-specific data.
+ *
+ * <p>The class deliberately has no compile-time dependency on the optional
+ * mods.  Adapters are loaded from the disposable exporter class path through
+ * {@link ServiceLoader}, or by the comma-separated
+ * {@code nesql.special.adapters} property.  This lets the overlay compile
+ * against the exact GTNH 2.9.0-beta-2 artifacts while keeping the pinned
+ * ShadowTheAge submodule unchanged.</p>
+ *
+ * <p>Adapters must use the sink instead of writing JSON themselves.  The sink
+ * performs stable ID checks, category coverage checks, reference retention,
+ * and deterministic serialization.</p>
+ */
+public final class NeiSpecialOverlay {
+    public static final int SCHEMA_VERSION = 1;
+    public static final String SIDECAR_FILE = "browser-nei-special.json";
+    public static final List<String> CATEGORIES = Collections.unmodifiableList(Arrays.asList(
+            "crop-output", "mutation-pool", "crop-breeding", "gt-ore-vein", "gt-small-ore",
+            "meteor-ritual", "loot-bag", "vending-trade", "worldgen-loot", "gt-ore-processing"));
+
+    /** Exact source versions are part of the sidecar provenance contract. */
+    private static final Map<String, Object> SOURCE_VERSIONS;
+
+    static {
+        Map<String, String> mods = new HashMap<>();
+        mods.put("CropsNH", "2.0.91");
+        mods.put("GT5-Unofficial", "5.09.54.20");
+        mods.put("BloodMagic", "1.9.4");
+        mods.put("EnhancedLootBags", "1.3.4");
+        mods.put("VendingMachine", "0.4.95");
+        mods.put("NEICustomDiagram", "1.8.30");
+        mods.put("RoguelikeDungeons", "1.6.6-GTNH");
+        mods.put("TwilightForest", "2.7.36");
+        Map<String, Object> exporter = new LinkedHashMap<>();
+        exporter.put("repository", "https://github.com/ShadowTheAge/nesql-exporter");
+        exporter.put("commit", "b9279b39f2f439da78eebd70fab272b028947371");
+        Map<String, Object> overlay = new LinkedHashMap<>();
+        overlay.put("version", "nei-special-v1");
+        Map<String, Object> versions = new LinkedHashMap<>();
+        versions.put("gtnhVersion", "2.9.0-beta-2");
+        versions.put("exporter", exporter);
+        versions.put("overlay", overlay);
+        versions.put("mods", mods);
+        SOURCE_VERSIONS = Collections.unmodifiableMap(versions);
+    }
+
+    private NeiSpecialOverlay() {}
+
+    /** Adapter SPI implemented by the disposable, mod-aware overlay sources. */
+    public interface Adapter {
+        void export(Sink sink) throws Exception;
+    }
+
+    /**
+     * Runs all installed adapters and writes one validated sidecar.  A normal
+     * exporter without the optional overlay providers continues to produce its
+     * historical database; a requested special-data processing run rejects
+     * that missing sidecar rather than accepting partial records.
+     */
+    public static void export(
+            File repositoryDirectory,
+            ExporterState exporterState,
+            Map<Plugin, PluginExporter> activePlugins) {
+        List<Adapter> adapters = loadAdapters();
+        if (adapters.isEmpty()) {
+            throw new IllegalStateException(
+                    "No NEI special-data adapters installed; requested categories cannot be exported");
+        }
+        Sink sink = new Sink(exporterState, activePlugins);
+        try {
+            for (Adapter adapter : adapters) adapter.export(sink);
+            sink.write(new File(repositoryDirectory, SIDECAR_FILE));
+        } catch (Exception error) {
+            throw new RuntimeException("NEI special-data export failed", error);
+        }
+    }
+
+    private static List<Adapter> loadAdapters() {
+        List<Adapter> adapters = new ArrayList<>();
+        Set<String> loaded = new HashSet<>();
+        for (Adapter adapter : ServiceLoader.load(Adapter.class)) {
+            if (loaded.add(adapter.getClass().getName())) adapters.add(adapter);
+        }
+        String configured = System.getProperty("nesql.special.adapters", "");
+        for (String className : configured.split(",")) {
+            String name = className.trim();
+            if (name.length() == 0 || !loaded.add(name)) continue;
+            try {
+                Object instance = Class.forName(name).newInstance();
+                if (!(instance instanceof Adapter)) {
+                    throw new IllegalArgumentException(name + " does not implement NeiSpecialOverlay.Adapter");
+                }
+                adapters.add((Adapter) instance);
+            } catch (ReflectiveOperationException error) {
+                throw new RuntimeException("Unable to load special-data adapter " + name, error);
+            }
+        }
+        return adapters;
+    }
+
+    /** Mutable adapter output that is canonicalized when written. */
+    public static final class Sink {
+        private final ExporterState exporterState;
+        private final Map<Plugin, PluginExporter> activePlugins;
+        private final ItemFactory itemFactory;
+        private final FluidFactory fluidFactory;
+        private final OreDictionaryFactory oreDictionaryFactory;
+        private final Map<String, Map<String, Object>> serviceIcons = new LinkedHashMap<>();
+        private final List<Map<String, Object>> records = new ArrayList<>();
+        private final Map<String, Map<String, Object>> viewTypes = new LinkedHashMap<>();
+
+        private Sink(ExporterState exporterState, Map<Plugin, PluginExporter> activePlugins) {
+            this.exporterState = exporterState;
+            this.activePlugins = activePlugins;
+            PluginExporter base = activePlugins.get(Plugin.BASE);
+            if (base == null) throw new IllegalStateException("base plugin is required by special adapters");
+            this.itemFactory = new ItemFactory(base);
+            this.fluidFactory = new FluidFactory(base);
+            this.oreDictionaryFactory = new OreDictionaryFactory(base);
+        }
+
+        /** Access the same persistence context used by the normal factories. */
+        public EntityManager getEntityManager() {
+            return exporterState.getEntityManager();
+        }
+
+        /** Access active plugin exporters without constructing a second registry. */
+        public Map<Plugin, PluginExporter> getActivePlugins() {
+            return Collections.unmodifiableMap(activePlugins);
+        }
+
+        /** Persist/render a referenced item through the normal base factory. */
+        public String retainItem(ItemStack stack) {
+            Item item = itemFactory.get(stack);
+            return browserItemId(item);
+        }
+
+        /** Persist/render a referenced fluid through the normal base factory. */
+        public String retainFluid(FluidStack stack) {
+            Fluid fluid = fluidFactory.get(stack);
+            return "f:" + fluid.getModId() + ":" + fluid.getInternalName();
+        }
+
+        private static String browserItemId(Item item) {
+            String id = "i:" + item.getModId() + ":" + item.getInternalName() + ":" + item.getItemDamage();
+            return item.hasNbt() ? id + ":" + sha1(item.getNbt()) : id;
+        }
+
+        private static String sha1(String value) {
+            final byte[] digest;
+            try {
+                digest = MessageDigest.getInstance("SHA-1").digest(value.getBytes(StandardCharsets.UTF_8));
+            } catch (NoSuchAlgorithmException error) {
+                throw new AssertionError("SHA-1 is required by the Java runtime", error);
+            }
+            StringBuilder result = new StringBuilder(digest.length * 2);
+            for (byte entry : digest) {
+                int unsigned = entry & 0xff;
+                result.append(Character.forDigit(unsigned >>> 4, 16));
+                result.append(Character.forDigit(unsigned & 0xf, 16));
+            }
+            return result.toString();
+        }
+
+        /** Persist an ore dictionary and all of its member item stacks. */
+        public String retainOreDictionary(String name, java.util.Collection<ItemStack> stacks) {
+            oreDictionaryFactory.get(name, stacks);
+            // Format-v5 persists the runtime entity as od~name, while the
+            // browser catalog's canonical goods identity is o:name.
+            return "o:" + name;
+        }
+
+        public void addServiceIcon(String id, String label) {
+            addServiceIcon(id, label, null);
+        }
+
+        public void addServiceIcon(String id, String label, String goodsId) {
+            requireId(id, "service icon");
+            requireId(label, "service icon label");
+            if (goodsId != null) requireId(goodsId, "service icon goods ID");
+            Map<String, Object> icon = new LinkedHashMap<>();
+            icon.put("id", id);
+            icon.put("label", label);
+            icon.put("searchable", false);
+            if (goodsId != null) icon.put("goodsId", goodsId);
+            serviceIcons.put(id, icon);
+        }
+
+        public void addViewType(String id, String name, String serviceIconId) {
+            requireCategory(id);
+            requireId(name, "view name");
+            requireId(serviceIconId, "view service icon");
+            Map<String, Object> view = new LinkedHashMap<>();
+            view.put("id", id);
+            view.put("name", name);
+            view.put("label", name);
+            view.put("order", CATEGORIES.indexOf(id));
+            view.put("serviceIconId", serviceIconId);
+            view.put("iconGoodsId", serviceIconId);
+            viewTypes.put(id, view);
+        }
+
+        public void addRecord(
+                String id,
+                String category,
+                String title,
+                List<String> goodsIds,
+                String recipesLookupId,
+                String usagesLookupId,
+                String serviceIconId,
+                Map<String, Object> payload) {
+            addRecord(
+                    id, category, title, title, goodsIds, recipesLookupId, usagesLookupId,
+                    serviceIconId, payload);
+        }
+
+        /** Adds a record with adapter-supplied, normalized plain search text. */
+        public void addRecord(
+                String id,
+                String category,
+                String title,
+                String searchText,
+                List<String> goodsIds,
+                String recipesLookupId,
+                String usagesLookupId,
+                String serviceIconId,
+                Map<String, Object> payload) {
+            requireId(id, "record");
+            requireCategory(category);
+            requireId(title, "record title");
+            requireId(searchText, "record search text");
+            requireId(recipesLookupId, "Recipes lookup");
+            requireId(usagesLookupId, "Usages lookup");
+            requireId(serviceIconId, "record service icon");
+            if (payload == null) throw new IllegalArgumentException("record payload is required for " + id);
+            List<String> references = sortedUnique(goodsIds, "goods IDs for " + id);
+            // The NEI tab itself is a service object, but its display stack is
+            // a normal catalog goods entry. Use the first retained category
+            // reference as a deterministic fallback when the adapter has not
+            // supplied a more specific handler icon. This keeps the icon
+            // searchable through normal factories without making the service
+            // object searchable.
+            Map<String, Object> serviceIcon = serviceIcons.get(serviceIconId);
+            if (serviceIcon != null && !serviceIcon.containsKey("goodsId") && !references.isEmpty()) {
+                serviceIcon.put("goodsId", references.get(0));
+            }
+            Map<String, Object> lookup = new LinkedHashMap<>();
+            // The explicit IDs are retained for the sidecar identity.  The
+            // lookup arrays are the normal goods indexes used by the pack
+            // builder, so every referenced value is validated against the
+            // processed item/fluid catalog instead of being mistaken for a
+            // goods ID named after the lookup itself.
+            lookup.put("recipes", references);
+            lookup.put("usages", references);
+            Map<String, Object> record = new LinkedHashMap<>();
+            record.put("id", id);
+            record.put("category", category);
+            record.put("type", category);
+            record.put("title", title);
+            record.put("name", title);
+            record.put("searchText", searchText);
+            record.put("goodsIds", references);
+            record.put("recipesLookupId", recipesLookupId);
+            record.put("usagesLookupId", usagesLookupId);
+            record.put("lookup", lookup);
+            record.put("serviceIconId", serviceIconId);
+            record.put("serviceIconIds", Collections.singletonList(serviceIconId));
+            record.put("payload", payload);
+            records.add(record);
+        }
+
+        private static List<String> sortedUnique(List<String> values, String context) {
+            if (values == null) throw new IllegalArgumentException(context + " are required");
+            List<String> result = new ArrayList<>(values);
+            for (String value : result) requireId(value, context);
+            Collections.sort(result);
+            for (int index = 1; index < result.size(); index++) {
+                if (result.get(index - 1).equals(result.get(index))) {
+                    throw new IllegalArgumentException("duplicate " + context + ": " + result.get(index));
+                }
+            }
+            return result;
+        }
+
+        private static void requireId(String value, String context) {
+            if (value == null || value.trim().length() == 0) {
+                throw new IllegalArgumentException(context + " must be non-empty");
+            }
+        }
+
+        private static void requireCategory(String value) {
+            requireId(value, "category");
+            if (!CATEGORIES.contains(value)) throw new IllegalArgumentException("unsupported category " + value);
+        }
+
+        private void validate() {
+            Set<String> categories = new LinkedHashSet<>();
+            Set<String> ids = new HashSet<>();
+            for (Map<String, Object> record : records) {
+                String id = (String) record.get("id");
+                if (!ids.add(id)) throw new IllegalArgumentException("duplicate special record " + id);
+                categories.add((String) record.get("category"));
+                String icon = (String) record.get("serviceIconId");
+                if (!serviceIcons.containsKey(icon)) throw new IllegalArgumentException("unknown service icon " + icon);
+            }
+            for (String category : CATEGORIES) {
+                if (!categories.contains(category)) throw new IllegalArgumentException("missing requested category " + category);
+            }
+            for (Map<String, Object> view : viewTypes.values()) {
+                if (!serviceIcons.containsKey(view.get("serviceIconId"))) {
+                    throw new IllegalArgumentException("unknown view service icon " + view.get("serviceIconId"));
+                }
+            }
+        }
+
+        private void write(File path) throws IOException {
+            validate();
+            records.sort((left, right) -> {
+                int category = Integer.compare(CATEGORIES.indexOf(left.get("category")), CATEGORIES.indexOf(right.get("category")));
+                if (category != 0) return category;
+                return ((String) left.get("id")).compareTo((String) right.get("id"));
+            });
+            List<String> iconIds = new ArrayList<>(serviceIcons.keySet());
+            Collections.sort(iconIds);
+            List<Map<String, Object>> icons = new ArrayList<>();
+            for (String iconId : iconIds) icons.add(serviceIcons.get(iconId));
+            List<Map<String, Object>> views = new ArrayList<>(viewTypes.values());
+            views.sort(Comparator.comparingInt(view -> CATEGORIES.indexOf(view.get("id"))));
+            Map<String, Object> root = new LinkedHashMap<>();
+            root.put("schemaVersion", SCHEMA_VERSION);
+            root.put("sourceVersions", SOURCE_VERSIONS);
+            root.put("categories", CATEGORIES);
+            root.put("serviceIconIds", iconIds);
+            root.put("serviceIcons", icons);
+            root.put("specialViewTypes", views);
+            root.put("records", records);
+
+            Path target = path.toPath().toAbsolutePath();
+            Path temporary = Files.createTempFile(target.getParent(), target.getFileName().toString(), ".tmp");
+            boolean moved = false;
+            try {
+                try (BufferedWriter writer = Files.newBufferedWriter(
+                        temporary,
+                        StandardCharsets.UTF_8,
+                        StandardOpenOption.WRITE,
+                        StandardOpenOption.TRUNCATE_EXISTING)) {
+                    Json.write(writer, root);
+                }
+                try {
+                    Files.move(
+                            temporary,
+                            target,
+                            StandardCopyOption.ATOMIC_MOVE,
+                            StandardCopyOption.REPLACE_EXISTING);
+                } catch (AtomicMoveNotSupportedException unsupported) {
+                    Files.move(temporary, target, StandardCopyOption.REPLACE_EXISTING);
+                }
+                moved = true;
+            } finally {
+                if (!moved) Files.deleteIfExists(temporary);
+            }
+        }
+    }
+
+    /** Streaming JSON encoder avoids depending on a mod's optional Gson version. */
+    private static final class Json {
+        private Json() {}
+
+        /** Kept separate from Sink.write so the deterministic writer is easy to exercise. */
+        static void write(Writer output, Object value) throws IOException {
+            append(output, value);
+            output.write('\n');
+        }
+
+        @SuppressWarnings("unchecked")
+        private static void append(Writer output, Object value) throws IOException {
+            if (value == null) { output.write("null"); return; }
+            if (value instanceof String) { quote(output, (String) value); return; }
+            if (value instanceof Boolean || value instanceof Number) { output.write(value.toString()); return; }
+            if (value instanceof Map) {
+                output.write('{');
+                boolean first = true;
+                List<String> keys = new ArrayList<>(((Map<String, Object>) value).keySet());
+                Collections.sort(keys);
+                for (String key : keys) {
+                    if (!first) output.write(',');
+                    first = false;
+                    quote(output, key);
+                    output.write(':');
+                    append(output, ((Map<String, Object>) value).get(key));
+                }
+                output.write('}');
+                return;
+            }
+            if (value instanceof Iterable) {
+                output.write('[');
+                boolean first = true;
+                for (Object entry : (Iterable<Object>) value) {
+                    if (!first) output.write(',');
+                    first = false;
+                    append(output, entry);
+                }
+                output.write(']');
+                return;
+            }
+            throw new IllegalArgumentException("unsupported JSON value " + value.getClass());
+        }
+
+        private static void quote(Writer output, String value) throws IOException {
+            output.write('"');
+            for (int index = 0; index < value.length(); index++) {
+                char character = value.charAt(index);
+                switch (character) {
+                    case '"': output.write("\\\""); break;
+                    case '\\': output.write("\\\\"); break;
+                    case '\n': output.write("\\n"); break;
+                    case '\r': output.write("\\r"); break;
+                    case '\t': output.write("\\t"); break;
+                    default:
+                        if (character < 0x20) output.write(String.format("\\u%04x", (int) character));
+                        else output.write(character);
+                }
+            }
+            output.write('"');
+        }
+    }
+}
