{
  "name": "gtnh-recipe-browser",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "audit:quest-items": "tsx tools/questbook/export-list.ts",
    "build:quests": "tsx tools/questbook/build.ts",
    "build:icons64": "tsx tools/high-resolution-icons/build.ts",
    "verify:icons64": "tsx tools/high-resolution-icons/verify.ts",
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "ui:extract": "tsx tools/machine-ui-export/launch.ts",
    "ui:atlas": "node tools/machine-ui-export/atlas.mjs",
    "ui:special-backgrounds": "node tools/machine-ui-export/special-backgrounds.mjs",
    "ui:ore-diagrams": "tsx tools/machine-ui-export/build-ore-diagrams.ts",
    "ui:buttons": "node tools/machine-ui-export/buttons.mjs",
    "build:chain-index": "tsx tools/build-chain-index.ts",
    "build": "vite build && node tools/verify-precache.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "deadcode": "node --max-old-space-size=12288 node_modules/knip/bin/knip.js --no-gitignore --no-config-hints",
    "quality": "npm run lint && npm run deadcode && npm run check && npm test && npm run build",
    "test": "vitest run",
    "pack": "tsx tools/pack-builder/cli.ts",
    "shared-layout": "tsx tools/pack-builder/shared-layout-cli.ts",
    "analyze:pack-reuse": "tsx tools/pack-analysis/compare-packs.ts",
    "analyze:icon-pixels": "tsx tools/pack-analysis/compare-icon-pixels.ts",
    "analyze:storage": "tsx tools/pack-analysis/storage-report.ts",
    "profile:incremental": "node tools/profile-incremental.mjs",
    "verify-pack": "tsx tools/pack-builder/verify-cli.ts",
    "export:process": "tsx tools/data-export/process.ts",
    "export:publish": "tsx tools/data-export/publish.ts",
    "export:direct": "tsx tools/data-export/direct-export-cli.ts",
    "fixture:browser-policy": "tsx tools/data-export/create-browser-policy-fixture.ts",
    "smoke:deploy": "node tools/deployment-smoke.mjs",
    "test:upgrade": "node tools/test-shell-upgrade.mjs",
    "test:rollout": "node tools/test-startup-rollout.mjs",
    "test:cached-startup": "node tools/test-cached-startup.mjs",
    "test:item-loading": "node tools/test-item-loading.mjs",
    "test:deferred-rollout": "node tools/test-deferred-rollout.mjs",
    "test:tooltip-hydration": "node tools/test-tooltip-hydration.mjs",
    "test:tooltip-spacing": "node tools/test-tooltip-spacing.mjs",
    "test:machine-ui": "node tools/test-machine-ui.mjs",
    "test:mc-controls": "node tools/test-mc-controls.mjs",
    "test:machine-crafters": "node tools/test-machine-crafters.mjs",
    "test:loot-grids": "node tools/test-loot-grids.mjs",
    "test:special-ui": "node tools/test-special-ui.mjs",
    "test:ore-diagrams": "node tools/test-ore-diagrams.mjs",
    "test:icon-stability": "node tools/test-icon-stability.mjs",
    "test:landing": "node tools/test-landing.mjs",
    "test:questbook": "node tools/test-questbook.mjs",
    "test:quest-links": "node tools/test-quest-links.mjs",
    "test:landing-loading": "node tools/test-landing-loading.mjs",
    "test:startup-responsiveness": "node tools/test-startup-responsiveness.mjs",
    "test:touch-items": "node tools/test-touch-items.mjs",
    "test:touch-refinements": "node tools/test-touch-refinements.mjs",
    "test:analytics": "node tools/test-analytics.mjs",
    "test:recipe-chain": "node tools/test-recipe-chain.mjs",
    "test:recipe-finder": "node tools/test-recipe-finder.mjs",
    "test:recipe-streaming": "node tools/test-recipe-streaming.mjs"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@noble/hashes": "^2.2.0",
    "idb": "^8.0.3",
    "posthog-js": "^1.444.0",
    "sharp": "^0.35.3",
    "svelte": "^5.35.5",
    "workbox-window": "^7.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@types/node": "^24.0.10",
    "eslint": "^10.7.0",
    "eslint-plugin-svelte": "^3.22.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "knip": "^6.29.0",
    "svelte-check": "^4.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.4",
    "vite-plugin-pwa": "^1.0.1",
    "vitest": "^3.2.4"
  }
}
