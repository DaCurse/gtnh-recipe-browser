{
  "name": "gtnh-recipe-browser",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "vite build && node tools/verify-precache.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "deadcode": "node --max-old-space-size=6144 node_modules/knip/bin/knip.js --no-config-hints",
    "quality": "npm run lint && npm run deadcode && npm run check && npm test && npm run build",
    "test": "vitest run",
    "pack": "tsx tools/pack-builder/cli.ts",
    "verify-pack": "tsx tools/pack-builder/verify-cli.ts",
    "export:process": "tsx tools/data-export/process.ts",
    "export:publish": "tsx tools/data-export/publish.ts",
    "export:direct": "tsx tools/data-export/direct-export-cli.ts",
    "fixture:browser-policy": "tsx tools/data-export/create-browser-policy-fixture.ts",
    "smoke:deploy": "node tools/deployment-smoke.mjs"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@noble/hashes": "^2.2.0",
    "idb": "^8.0.3",
    "sharp": "^0.35.3",
    "svelte": "^5.35.5",
    "workbox-window": "^7.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@types/node": "^24.0.10",
    "eslint": "^10.7.0",
    "eslint-plugin-svelte": "^3.22.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "knip": "^6.29.0",
    "svelte-check": "^4.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.4",
    "vite-plugin-pwa": "^1.0.1",
    "vitest": "^3.2.4"
  }
}
